<Window x:Class="AIConsole.Views.AttachmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attachment" Width="760" Height="600" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DetailsText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{DynamicResource IconButton}" Content="&#x2715;" FontSize="13"
                    ToolTip="Close" Click="Close_Click" VerticalAlignment="Top"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
                <ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <Image x:Name="ImageView" Stretch="None"/>
                </ScrollViewer>
                <TextBox x:Name="TextView" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"
                         FontFamily="{DynamicResource FontMono}" FontSize="12.5" Visibility="Collapsed"/>
                <TextBlock x:Name="UnavailableText" Text="No in-app preview is available for this file. Use Save as… to keep a copy."
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save as…" Click="Save_Click" Margin="0,0,8,0"/>
            <Button Content="Open in default app" Click="Open_Click" Margin="0,0,8,0"/>
            <Button Style="{DynamicResource AccentButton}" Content="Close" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
