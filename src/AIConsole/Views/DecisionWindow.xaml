<Window x:Class="AIConsole.Views.DecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decision" Width="640" Height="740" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceAltBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Make a decision" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Uses the selected model and endpoint's /v1/systemone API. Not all providers support this API." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16"/>
                <TextBlock Text="State" FontWeight="SemiBold"/>
                <TextBlock Text="The facts or context to evaluate (plain text or a JSON object or array)." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,5"/>
                <TextBox x:Name="StateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Question / task" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <TextBox x:Name="TaskBox" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Question type" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <ComboBox x:Name="TypeBox" SelectedIndex="0" SelectionChanged="Type_Changed" HorizontalAlignment="Left" Width="180">
                    <ComboBoxItem Content="choice"/><ComboBoxItem Content="score"/><ComboBoxItem Content="noul"/>
                </ComboBox>
                <TextBlock x:Name="CriteriaHint" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5"/>
                <TextBox x:Name="CriteriaBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Result" FontWeight="SemiBold" Margin="0,14,0,5"/>
                <TextBlock x:Name="StatusText" Text="Run a decision to see the result here." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock Text="{Binding Model, StringFormat='Model: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Answers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Type}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Confidence, StringFormat='Confidence: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Confidence}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Probabilities}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <StackPanel Margin="0,3,0,5">
                                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DisplayValue}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DockPanel>
                                                    <ProgressBar Value="{Binding BarValue}" Maximum="100" Height="5" Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}">
                                                        <ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding HasBar}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Raw response" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBox Text="{Binding Raw}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="160" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RunButton" Content="Run decision" Style="{DynamicResource AccentButton}" Click="Run_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
