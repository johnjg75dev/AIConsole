<UserControl x:Class="AIConsole.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AIConsole.Views.Controls"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <UserControl.Resources>
        <Style x:Key="FormSection" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FormHelp" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <TabControl Grid.Row="0" BorderThickness="0" Background="Transparent" Padding="0" Margin="14,8,14,4">

            <!-- ================= MODELS & ENDPOINTS ================= -->
            <TabItem Header="Models &amp; Endpoints">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" Padding="4,12,4,4">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Endpoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="13.5" ToolTip="Endpoint name"/>
                                                <Button Grid.Column="1" Style="{DynamicResource IconButton}" Content="&#x2715;" FontSize="14" ToolTip="Remove endpoint"
                                                        Command="{Binding DataContext.DeleteEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                            <TextBlock Text="Base URL" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                                            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="12.5" ToolTip="e.g. https://api.openai.com/v1 or http://localhost:11434/v1"/>
                                            <TextBlock Text="API key (optional)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/>
                                            <controls:BoundPasswordBox BoundPassword="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                                       FontSize="12.5" ToolTip="Stored encrypted (Windows DPAPI). Leave empty for no auth."/>
                                            <Grid Margin="0,10,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{DynamicResource FluentButton}" Content="Fetch models" Padding="10,6" FontSize="12"
                                                        Command="{Binding DataContext.FetchModelsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <CheckBox Grid.Column="1" Content="Always show all models (auto-refresh)" IsChecked="{Binding ShowAllModels, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FetchStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="Select all" IsThreeState="True" IsChecked="{Binding AllSelected, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"
                                                              Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding Models}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate><CheckBox Content="{Binding ModelId}" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontFamily="Cascadia Code, Consolas" Margin="14,1,0,1"/></DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Content="Save &amp; fetch" Padding="12,7" FontSize="12.5"
                                                        Command="{Binding DataContext.SaveEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{DynamicResource FluentButton}" Content="+  Add endpoint" Command="{Binding AddEndpointCommand}" HorizontalAlignment="Left" Padding="12,8"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= IMPORT ================= -->
            <TabItem Header="Import">
                <StackPanel Margin="4,12,4,4" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Import OpenAI-compatible endpoints from OpenCode, Continue, Zed, or a JSON file. Local servers (Ollama, LM Studio, ...) can be auto-detected." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{DynamicResource FluentButton}" Content="Scan installed tools" Padding="10,6" FontSize="12" Margin="0,0,8,0" Command="{Binding ScanImportsCommand}"/>
                        <Button Style="{DynamicResource FluentButton}" Content="Detect local servers" Padding="10,6" FontSize="12" Margin="0,0,8,0" Command="{Binding DetectLocalServersCommand}"/>
                        <Button Style="{DynamicResource FluentButton}" Content="Import file..." Padding="10,6" FontSize="12" Click="ImportFromFile_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Imports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding BaseUrl}"/><Run Text=" · "/><Run Text="{Binding Source}"/></TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{DynamicResource AccentButton}" Content="Import" Padding="10,6" FontSize="12"
                                                Command="{Binding DataContext.ImportEndpointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ================= WINDOW & HOTKEY ================= -->
            <TabItem Header="Window &amp; Hotkey">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" Padding="4,12,4,4">
                    <controls:ResponsiveColumnsPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="BEHAVIOR" Style="{StaticResource FormSection}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Global hotkey" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Click the box, then press a key combination (needs a modifier)." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <controls:HotkeyBox Grid.Column="1" x:Name="HotkeyCapture" HorizontalAlignment="Left" Width="220"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Slide in from" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SlideEdges}" SelectedItem="{Binding SlideEdge}" Width="150" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Always on top" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Keeps the panel above other windows." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hide when focus is lost" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="When off, use Esc, the hotkey, or the close button to hide the panel." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding HideOnFocusLoss}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Acrylic / blurred backdrop" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Uses the Windows transparent backdrop when available." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding PanelAcrylic}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Launch AIConsole when you sign in." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="LAYOUT" Style="{StaticResource FormSection}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Panel width" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Pixels; 0 = auto (full width when sliding from the top)." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding PanelWidth, UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Panel height" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Pixels." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding PanelHeight, UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Panel opacity" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Lower values let you see the desktop through the panel background." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Slider Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                            Value="{Binding PanelOpacity}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PanelOpacity, StringFormat={}{0:P0}}" Width="42"
                                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5"/>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Horizontal offset (px)" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Shift right from the edge anchor." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding PanelOffsetX, UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Vertical offset (px)" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Shift down from the edge anchor. 0,0 is the anchor corner." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding PanelOffsetY, UpdateSourceTrigger=LostFocus}" Width="110" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Refresh model lists" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Minutes between automatic model refreshes." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding RefreshMinutes, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>
                        </StackPanel>
                    </controls:ResponsiveColumnsPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= APPEARANCE ================= -->
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" Padding="4,12,4,4">
                    <controls:ResponsiveColumnsPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="THEME" Style="{StaticResource FormSection}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Match Windows theme" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Follow the system light/dark mode instead of the selected theme." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding FollowWindowsTheme}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Theme" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Applies live; reverts if you Cancel." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}"
                                          Width="190" HorizontalAlignment="Left" FontSize="12.5"
                                          SelectionChanged="Theme_SelectionChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Accent color" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Click a swatch to recolor buttons and highlights." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding AccentSwatches}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Width="26" Height="26" Margin="0,0,8,8" Cursor="Hand" BorderThickness="1" Padding="0" BorderBrush="{DynamicResource BorderBrush}" Background="{Binding}" Tag="{Binding}" Click="Accent_Click"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="CODE" Style="{StaticResource FormSection}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Code line numbers" Style="{StaticResource FormLabel}"/>
                                    <TextBlock Text="Show a gutter in Markdown code blocks." Style="{StaticResource FormHelp}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowLineNumbers}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Code font" Style="{StaticResource FormLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CodeFonts}" SelectedItem="{Binding CodeFont}"
                                          Width="180" HorizontalAlignment="Left" FontSize="12.5"/>
                            </Grid>
                        </StackPanel>
                    </controls:ResponsiveColumnsPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= CHAT ================= -->
            <TabItem Header="Chat">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" Padding="4,12,4,4">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="MESSAGES" Style="{StaticResource FormSection}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Replace last message" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="When using Edit as new on the last message, remove it before sending the new one." Style="{StaticResource FormHelp}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding ReplaceLastMessageOnEditAsNew}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Enter sends" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="When off, use Ctrl+Enter to send and Enter for a newline." Style="{StaticResource FormHelp}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding EnterToSend}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="ATTACHMENTS" Style="{StaticResource FormSection}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Send attachments to the model" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="Off by default. Attachments stay visible in history but are not included in outgoing requests." Style="{StaticResource FormHelp}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding SendAttachments}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= NOTIFICATIONS ================= -->
            <TabItem Header="Notifications">
                <StackPanel Margin="4,12,4,4" MaxWidth="760" HorizontalAlignment="Left">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Completion notification" Style="{StaticResource FormLabel}"/>
                            <TextBlock Text="Show a Windows notification when a reply is completed (tray)." Style="{StaticResource FormHelp}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding NotifyOnCompletion}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ================= APPLY / CANCEL ================= -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SurfaceAltBrush}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Style="{DynamicResource FluentButton}" Content="Cancel" Command="{Binding CancelCommand}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Style="{DynamicResource AccentButton}" Content="Apply" Command="{Binding ApplyCommand}" Padding="16,8" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
