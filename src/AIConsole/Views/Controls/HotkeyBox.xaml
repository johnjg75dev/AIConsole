<UserControl x:Class="AIConsole.Views.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border x:Name="CaptureBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="9" Background="{DynamicResource SurfaceAltBrush}" Padding="10,8" MinWidth="150"
            Focusable="False">
        <TextBlock x:Name="Display" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                   VerticalAlignment="Center" Text="Ctrl+`"/>
    </Border>
</UserControl>
