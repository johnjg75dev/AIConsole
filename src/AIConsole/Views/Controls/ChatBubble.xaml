<UserControl x:Class="AIConsole.Views.Controls.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid" Margin="0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Bubble" Grid.Row="0" MaxWidth="600" CornerRadius="16" Padding="12,9"
                HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>

            <Grid>
                <TextBlock x:Name="StreamingText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13.5"/>
                <ContentPresenter x:Name="MarkdownHost" Content="{Binding Rendered}"/>
            </Grid>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy" Command="{Binding CopyCommand}" Icon="&#xE8C8;"/>
                    <MenuItem Header="Remove from history" Command="{Binding RemoveCommand}" Icon="&#xE74D;"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <Grid Grid.Row="1" Margin="2,3,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Actions" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Opacity="0">
                <Button Style="{DynamicResource IconButton}" Content="&#xE8C8;" FontSize="12" Padding="5"
                        Command="{Binding CopyCommand}" ToolTip="Copy"/>
                <Button Style="{DynamicResource IconButton}" Content="&#xE74D;" FontSize="12" Padding="5"
                        Command="{Binding RemoveCommand}" ToolTip="Remove from history"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="6,0,0,0">
                <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimestampText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
