<UserControl x:Class="AIConsole.Views.Controls.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AIConsole.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid" Margin="0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Bubble" Grid.Row="0" MaxWidth="600" CornerRadius="16" Padding="12,9"
                HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>

            <StackPanel>
              <Grid>
                <TextBlock x:Name="StreamingText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13.5"/>
                <ContentPresenter x:Name="MarkdownHost" Content="{Binding Rendered}"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,7,0,0"
                            Visibility="{Binding HasAttachments, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                      <DataTemplate>
                          <Button Click="Attachment_Click" Cursor="Hand" Padding="0" Margin="0,0,6,6"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                                  ToolTip="Open attachment">
                              <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1" CornerRadius="8" Padding="6">
                                  <StackPanel>
                                      <Image Source="{Binding Preview}" MaxWidth="260" MaxHeight="150" Stretch="Uniform"
                                             Margin="0,0,0,4"
                                             Visibility="{Binding HasPreview, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}"/>
                                      <StackPanel Orientation="Horizontal">
                                          <TextBlock Text="📎" FontSize="11" Margin="0,0,4,0"/>
                                          <TextBlock Text="{Binding Name}" FontSize="11" MaxWidth="240"
                                                     TextTrimming="CharacterEllipsis"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                      </StackPanel>
                                  </StackPanel>
                              </Border>
                          </Button>
                      </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel DataContext="{Binding}" Visibility="{Binding IsEditing, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
                  <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinWidth="240" MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8,0,6"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Cancel" Command="{Binding CancelEditCommand}" Margin="0,0,6,0"/>
                      <Button Content="Save" Command="{Binding SaveEditCommand}"/>
                  </StackPanel>
              </StackPanel>
            </StackPanel>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit message" Command="{Binding EditCommand}"/>
                    <MenuItem Header="Copy" Command="{Binding CopyCommand}" Icon="&#x29C9;"/>
                    <MenuItem Header="Remove from history" Command="{Binding RemoveCommand}" Icon="&#x2715;"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <StackPanel x:Name="Footer" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="2,3,2,0">
            <StackPanel x:Name="MetaPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimestampText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="Actions" Orientation="Horizontal" VerticalAlignment="Center"
                        Opacity="0" Visibility="Collapsed">
                <Button Style="{DynamicResource IconButton}" Content="✎" FontSize="12" Padding="5"
                        Command="{Binding EditCommand}" ToolTip="Edit message"/>
                <Button Style="{DynamicResource IconButton}" Content="&#x29C9;" FontSize="12" Padding="5"
                        Command="{Binding CopyCommand}" ToolTip="Copy"/>
                <Button Style="{DynamicResource IconButton}" Content="&#x2715;" FontSize="12" Padding="5"
                        Command="{Binding RemoveCommand}" ToolTip="Remove from history"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
