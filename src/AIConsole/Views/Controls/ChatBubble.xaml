<UserControl x:Class="AIConsole.Views.Controls.ChatBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:AIConsole.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid" Margin="0,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="Bubble" Grid.Row="0" MaxWidth="600" CornerRadius="16" Padding="12,9"
                HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>

            <StackPanel>
              <Grid>
                <TextBlock x:Name="StreamingText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13.5"/>
                <ContentPresenter x:Name="MarkdownHost" Content="{Binding Rendered}"/>
              </Grid>
              <TextBlock Text="{Binding AttachmentsLabel}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Visibility="{Binding AttachmentsLabel, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>
              <StackPanel>
                  <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                  <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinWidth="240" MinHeight="70" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8,0,6"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="Cancel" Command="{Binding CancelEditCommand}" Margin="0,0,6,0"/>
                      <Button Content="Save" Command="{Binding SaveEditCommand}"/>
                  </StackPanel>
              </StackPanel>
            </StackPanel>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit message" Command="{Binding EditCommand}"/>
                    <MenuItem Header="Copy" Command="{Binding CopyCommand}" Icon="&#x29C9;"/>
                    <MenuItem Header="Remove from history" Command="{Binding RemoveCommand}" Icon="&#x2715;"/>
                </ContextMenu>
            </Border.ContextMenu>
        </Border>

        <Grid Grid.Row="1" Margin="2,3,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="Actions" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Opacity="0">
                <Button Style="{DynamicResource IconButton}" Content="✎" FontSize="12" Padding="5"
                        Command="{Binding EditCommand}" ToolTip="Edit message"/>
                <Button Style="{DynamicResource IconButton}" Content="&#x29C9;" FontSize="12" Padding="5"
                        Command="{Binding CopyCommand}" ToolTip="Copy"/>
                <Button Style="{DynamicResource IconButton}" Content="&#x2715;" FontSize="12" Padding="5"
                        Command="{Binding RemoveCommand}" ToolTip="Remove from history"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="6,0,0,0">
                <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" · " FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TimestampText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
