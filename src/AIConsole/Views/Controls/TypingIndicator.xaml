<UserControl x:Class="AIConsole.Views.Controls.TypingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="28" Height="18"
             Focusable="False" IsHitTestVisible="False"
             ToolTip="Waiting for the model to respond"
             AutomationProperties.Name="Waiting for the model to respond">
    <UserControl.Resources>
        <QuadraticEase x:Key="RiseEase" EasingMode="EaseOut"/>
        <QuadraticEase x:Key="FallEase" EasingMode="EaseIn"/>

        <Storyboard x:Key="Bounce">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           Duration="0:0:0.9" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-5" EasingFunction="{StaticResource RiseEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource FallEase}"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           BeginTime="0:0:0.12"
                                           Duration="0:0:0.9" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-5" EasingFunction="{StaticResource RiseEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource FallEase}"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           BeginTime="0:0:0.24"
                                           Duration="0:0:0.9" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-5" EasingFunction="{StaticResource RiseEase}"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" EasingFunction="{StaticResource FallEase}"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
        <Ellipse x:Name="Dot1" Width="6" Height="6" Margin="0,0,5,0"
                 Fill="{DynamicResource TextSecondaryBrush}">
            <Ellipse.RenderTransform><TranslateTransform Y="0"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dot2" Width="6" Height="6" Margin="0,0,5,0"
                 Fill="{DynamicResource TextSecondaryBrush}">
            <Ellipse.RenderTransform><TranslateTransform Y="0"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Dot3" Width="6" Height="6"
                 Fill="{DynamicResource TextSecondaryBrush}">
            <Ellipse.RenderTransform><TranslateTransform Y="0"/></Ellipse.RenderTransform>
        </Ellipse>
    </StackPanel>
</UserControl>
