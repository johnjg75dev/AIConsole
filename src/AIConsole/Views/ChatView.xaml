<UserControl x:Class="AIConsole.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AIConsole.Views.Controls"
             xmlns:converters="clr-namespace:AIConsole.Converters"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ sidebar ═══ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Visibility="{Binding SidebarVisible, Converter={x:Static converters:BoolToVisibilityConverter.Instance}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10,10,10,6">
                    <Button Style="{DynamicResource AccentButton}" Content="＋  New chat" Command="{Binding NewChatCommand}"
                            HorizontalAlignment="Stretch" Padding="10,8" FontWeight="SemiBold"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,0,4,8">
                    <ItemsControl ItemsSource="{Binding Conversations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Border x:Name="ConvBg" CornerRadius="9" Padding="10,8" Background="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="Conversation_Click"
                                            ToolTip="Right-click to rename or remove">
                                        <Border.ContextMenu>
                                            <ContextMenu Opened="ConversationMenu_Opened"
                                                         DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Rename…" Click="RenameConversation_Click"/>
                                                <MenuItem Header="Remove" Click="RemoveConversation_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,8,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastMessageAt, Converter={x:Static converters:ActivityTimeConverter.Instance}}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ chat column ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{DynamicResource IconButton}" Content="&#x2630;" FontSize="15"
                        ToolTip="Toggle conversations" Command="{Binding ToggleSidebarCommand}" Margin="0,0,6,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                          DisplayMemberPath="Display" MinWidth="220" MaxWidth="420" HorizontalAlignment="Left"
                          ToolTip="Choose model" FontSize="12.5"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Decision" ToolTip="Evaluate a task with a System One decision model" Click="Decision_Click" Margin="0,0,6,0"/>
                    <Button Style="{DynamicResource IconButton}" Content="&#x21BB;" FontSize="15" ToolTip="Refresh models" Command="{Binding RebuildModelsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- messages -->
            <ScrollViewer Grid.Row="1" x:Name="MsgScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="12,4,12,4">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><controls:ChatBubble/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- A quiet starting point when there are no messages yet. -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="✦" Foreground="{DynamicResource OnAccentBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Start a conversation" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a model and ask anything." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- status -->
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource ErrorBrush}"
                       FontSize="11.5" Margin="14,0,14,2" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={x:Static converters:StringToVisibilityConverter.Instance}}"/>

            <!-- composer -->
            <StackPanel Grid.Row="3" Margin="12,4,12,12">
                <ItemsControl ItemsSource="{Binding PendingAttachments}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,5,4" Padding="7,2">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                <Button Content="✕" ToolTip="Remove attachment" Style="{DynamicResource IconButton}" Padding="5" Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="📎" ToolTip="Attach text or image files" Style="{DynamicResource IconButton}" Click="Attach_Click" VerticalAlignment="Bottom" Margin="3,4"/>
                        <TextBlock Grid.Column="1" Text="Message your model…" Margin="12,8,0,0" FontSize="13.5"
                                   Foreground="{DynamicResource TextDisabledBrush}" IsHitTestVisible="False" Panel.ZIndex="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="1" x:Name="InputBox" BorderThickness="0" Background="Transparent" FontSize="13.5"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="38" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto" Padding="8,8"
                                 ToolTip="Enter to send · Shift+Enter for newline" PreviewKeyDown="InputBox_PreviewKeyDown"/>
                        <Button Grid.Column="2" x:Name="SendButton" Width="40" Height="40" Margin="4" VerticalAlignment="Bottom"
                                ToolTip="Send" FontFamily="{DynamicResource FontGlyph}" FontSize="15"
                                Click="Send_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsStreaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#x27A4;" Foreground="{DynamicResource OnAccentBrush}"/>
                        </Button>
                        <Button Grid.Column="2" Width="40" Height="40" Margin="4" VerticalAlignment="Bottom"
                                Command="{Binding StopCommand}" ToolTip="Stop generating" Content="■">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FluentButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsStreaming}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
