<Window x:Class="AIConsole.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabelText" Grid.Row="0" FontSize="12.5" FontWeight="SemiBold"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Margin="0,8,0,0" FontSize="13" TextChanged="Value_TextChanged"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,7" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="Rename" IsDefault="True" Padding="14,7"
                    Style="{DynamicResource AccentButton}" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
