<Window x:Class="AIConsole.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIConsole"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="CanResize"
        Width="880" Height="600" MinWidth="520" MinHeight="380"
        WindowStartupLocation="Manual" ShowActivated="False">
    <Window.Resources>
        <Storyboard x:Key="Noop"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform><TranslateTransform x:Name="SlideTransform" Y="0"/></Grid.RenderTransform>

        <Border x:Name="PanelBorder" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource PanelShadowColor}"
                                  BlurRadius="34" ShadowDepth="0" Opacity="0.35" x:Name="PanelShadow"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- ═══ slim draggable header ═══ -->
                <Grid x:Name="DragHeader" Grid.Row="0" Height="44" Background="{DynamicResource SurfaceAltBrush}"
                      MouseLeftButtonDown="DragHeader_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="16" Height="16" CornerRadius="5" VerticalAlignment="Center" Background="{DynamicResource AccentGradientBrush}"/>
                        <TextBlock Text="AIConsole" FontWeight="Bold" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- thin drag handle hint -->
                    <Border Grid.Column="1" Width="34" Height="4" CornerRadius="2" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{DynamicResource IconButton}" Content="&#xE713;" FontSize="15" ToolTip="Settings"
                                Click="Settings_Click"/>
                        <Button Style="{DynamicResource IconButton}" Content="&#xE8BB;" FontSize="13" ToolTip="Hide (Esc)"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ═══ content: chat ↔ settings ═══ -->
                <Grid Grid.Row="1">
                    <Grid x:Name="ChatHost"/>
                    <Grid x:Name="SettingsHost" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
