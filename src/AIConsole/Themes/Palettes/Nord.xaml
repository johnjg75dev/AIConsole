<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#242933"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F02E3440"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#434C5E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEFF4"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B1C4"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6B768E"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#81A1C1"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#5588C0D0"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#2E3440"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#88C0D0" Offset="0"/>
        <GradientStop Color="#81A1C1" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="PanelShadowColor">#81A1C1</Color>

    <LinearGradientBrush x:Key="BubbleUserBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#88C0D0" Offset="0"/>
        <GradientStop Color="#81A1C1" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BubbleUserTextBrush" Color="#2E3440"/>
    <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="BubbleAssistantTextBrush" Color="#ECEFF4"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#A3BE8C"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#BF616A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#EBCB8B"/>

    <SolidColorBrush x:Key="SyntaxBackgroundBrush" Color="#2B313C"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#313946"/>
    <SolidColorBrush x:Key="SyntaxLineNumberBrush" Color="#616E88"/>
    <SolidColorBrush x:Key="SyntaxGutterBorderBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="SyntaxPlainBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#81A1C1"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A3BE8C"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#616E88"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B48EAD"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#8FBCBB"/>
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#88C0D0"/>
    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#81A1C1"/>
    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#B6BFCC"/>
    <SolidColorBrush x:Key="SyntaxTagBrush" Color="#8FBCBB"/>
    <SolidColorBrush x:Key="SyntaxAttributeBrush" Color="#D08770"/>
    <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#5E81AC"/>
    <SolidColorBrush x:Key="SyntaxConstantBrush" Color="#B48EAD"/>
</ResourceDictionary>
