<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B12"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#E615151F"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1D1D2B"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262638"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#33334A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9AB0"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C5C72"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#557C3AED"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="PanelShadowColor">#7C3AED</Color>

    <LinearGradientBrush x:Key="BubbleUserBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#5B54E6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BubbleUserTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#1B1B28"/>
    <SolidColorBrush x:Key="BubbleAssistantTextBrush" Color="#F2F2F7"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FB7185"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

    <SolidColorBrush x:Key="SyntaxBackgroundBrush" Color="#101019"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#1A1A27"/>
    <SolidColorBrush x:Key="SyntaxLineNumberBrush" Color="#4E4E68"/>
    <SolidColorBrush x:Key="SyntaxGutterBorderBrush" Color="#2A2A3E"/>
    <SolidColorBrush x:Key="SyntaxPlainBrush" Color="#E2E2EC"/>
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#C792EA"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#C3E88D"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#67708A"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#F78C6C"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#82AAFF"/>
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#FFCB6B"/>
    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#89DDFF"/>
    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#B0B6C8"/>
    <SolidColorBrush x:Key="SyntaxTagBrush" Color="#F07178"/>
    <SolidColorBrush x:Key="SyntaxAttributeBrush" Color="#FFCB6B"/>
    <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#C792EA"/>
    <SolidColorBrush x:Key="SyntaxConstantBrush" Color="#FF9CAC"/>
</ResourceDictionary>
