<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C120E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#EA141C17"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1D2721"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#273329"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#31413A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDF4EC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A993"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5B6E5D"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#84CC16"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#5510B981"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#06150F"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#84CC16" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="PanelShadowColor">#10B981</Color>

    <LinearGradientBrush x:Key="BubbleUserBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#059669" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BubbleUserTextBrush" Color="#06150F"/>
    <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#1B251F"/>
    <SolidColorBrush x:Key="BubbleAssistantTextBrush" Color="#EDF4EC"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

    <SolidColorBrush x:Key="SyntaxBackgroundBrush" Color="#111A14"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#16211A"/>
    <SolidColorBrush x:Key="SyntaxLineNumberBrush" Color="#4C5F50"/>
    <SolidColorBrush x:Key="SyntaxGutterBorderBrush" Color="#26332A"/>
    <SolidColorBrush x:Key="SyntaxPlainBrush" Color="#E3EDE3"/>
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A3E635"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#5B7260"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#86EFAC"/>
    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#67E8F9"/>
    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#A8B8A8"/>
    <SolidColorBrush x:Key="SyntaxTagBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="SyntaxAttributeBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="SyntaxConstantBrush" Color="#FDA4AF"/>
</ResourceDictionary>
