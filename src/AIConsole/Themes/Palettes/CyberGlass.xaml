<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#05060A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B0101220"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#CC151724"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#20232F"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A4258"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8DA2C0"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#4E5A72"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#EC4899"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#55EC4899"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC4899" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="PanelShadowColor">#22D3EE</Color>

    <LinearGradientBrush x:Key="BubbleUserBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC4899" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BubbleUserTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#151724"/>
    <SolidColorBrush x:Key="BubbleAssistantTextBrush" Color="#EAF2FF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>

    <SolidColorBrush x:Key="SyntaxBackgroundBrush" Color="#0B0D16"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#121421"/>
    <SolidColorBrush x:Key="SyntaxLineNumberBrush" Color="#444C66"/>
    <SolidColorBrush x:Key="SyntaxGutterBorderBrush" Color="#242840"/>
    <SolidColorBrush x:Key="SyntaxPlainBrush" Color="#D6E1F5"/>
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#5EEAD4"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#5B6480"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#FDE047"/>
    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#A3ADC2"/>
    <SolidColorBrush x:Key="SyntaxTagBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="SyntaxAttributeBrush" Color="#67E8F9"/>
    <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#C084FC"/>
    <SolidColorBrush x:Key="SyntaxConstantBrush" Color="#F9A8D4"/>
</ResourceDictionary>
