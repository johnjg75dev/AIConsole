<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D23"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9CA3AF"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#554F46E5"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="PanelShadowColor">#4F46E5</Color>

    <LinearGradientBrush x:Key="BubbleUserBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4F46E5" Offset="0"/>
        <GradientStop Color="#4338CA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BubbleUserTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BubbleAssistantTextBrush" Color="#1A1D23"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>

    <SolidColorBrush x:Key="SyntaxBackgroundBrush" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="CodeHeaderBackgroundBrush" Color="#ECEEF1"/>
    <SolidColorBrush x:Key="SyntaxLineNumberBrush" Color="#A6ADBA"/>
    <SolidColorBrush x:Key="SyntaxGutterBorderBrush" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="SyntaxPlainBrush" Color="#1A1D23"/>
    <SolidColorBrush x:Key="SyntaxKeywordBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SyntaxStringBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#8A94A6"/>
    <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="SyntaxTypeBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="SyntaxFunctionBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SyntaxOperatorBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="SyntaxPunctuationBrush" Color="#5B6472"/>
    <SolidColorBrush x:Key="SyntaxTagBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="SyntaxAttributeBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="SyntaxPreprocessorBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SyntaxConstantBrush" Color="#BE185D"/>
</ResourceDictionary>
